<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HubLink.Desktop.Views.MainWindow"
        Title="HubLink | Shipment Operations"
        Width="1220" Height="850" MinWidth="980" MinHeight="700"
        Background="#F4F7FB">
  <Window.Styles>
    <Style Selector="TextBlock.kicker">
      <Setter Property="Foreground" Value="#64748B" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="Foreground" Value="#64748B" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#1E293B" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
  </Window.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32" Spacing="20">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="5">
          <TextBlock Classes="kicker" Text="HUBLINK  /  REGIONAL LOGISTICS" />
          <TextBlock Text="Shipment operations" FontSize="30" FontWeight="Bold" Foreground="#0F172A" />
          <TextBlock Text="Retrieve, review, and export your branch shipments." Foreground="#64748B" FontSize="14" />
        </StackPanel>
        <Border Grid.Column="1" Background="#E8F0FF" CornerRadius="12" Padding="14,10" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="#2563EB" />
            <TextBlock Text="API CLIENT" Foreground="#1D4ED8" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="18">
        <Grid ColumnDefinitions="2.1*,1*,1.7*,1*,Auto" ColumnSpacing="14" VerticalAlignment="Bottom">
          <StackPanel Grid.Column="0">
            <TextBlock Classes="field-label" Text="SERVICE ADDRESS" />
            <TextBox IsEnabled="{Binding IsNotBusy}" Text="{Binding BaseAddress, Mode=TwoWay}" Watermark="http://127.0.0.1:5080" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Classes="field-label" Text="BRANCH CODE" />
            <TextBox IsEnabled="{Binding IsNotBusy}" Text="{Binding BranchCode, Mode=TwoWay}" Watermark="BR-001" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="field-label" Text="ENDPOINT PATH" />
            <TextBox IsEnabled="{Binding IsNotBusy}" Text="{Binding EndpointPath, Mode=TwoWay}" Watermark="/api/shipments" />
          </StackPanel>
          <StackPanel Grid.Column="3">
            <TextBlock Classes="field-label" Text="TEST MODE" />
            <TextBox IsEnabled="{Binding IsNotBusy}" Text="{Binding TestMode, Mode=TwoWay}" Watermark="Leave blank" />
          </StackPanel>
          <Button Grid.Column="4" Classes="primary" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsNotBusy}" MinWidth="124" VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="↻" FontSize="16" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
          <StackPanel Spacing="8"><TextBlock Classes="kicker" Text="TOTAL SHIPMENTS"/><TextBlock Text="{Binding TotalCount}" FontSize="28" FontWeight="Bold" Foreground="#0F172A"/></StackPanel>
        </Border>
        <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
          <StackPanel Spacing="8"><TextBlock Classes="kicker" Text="PENDING"/><TextBlock Text="{Binding PendingCount}" FontSize="28" FontWeight="Bold" Foreground="#B45309"/></StackPanel>
        </Border>
        <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
          <StackPanel Spacing="8"><TextBlock Classes="kicker" Text="IN TRANSIT"/><TextBlock Text="{Binding InTransitCount}" FontSize="28" FontWeight="Bold" Foreground="#2563EB"/></StackPanel>
        </Border>
        <Border Grid.Column="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
          <StackPanel Spacing="8"><TextBlock Classes="kicker" Text="DELIVERED"/><TextBlock Text="{Binding DeliveredCount}" FontSize="28" FontWeight="Bold" Foreground="#15803D"/></StackPanel>
        </Border>
        <Border Grid.Column="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16">
          <StackPanel Spacing="8"><TextBlock Classes="kicker" Text="EXCEPTION"/><TextBlock Text="{Binding ExceptionCount}" FontSize="28" FontWeight="Bold" Foreground="#B91C1C"/></StackPanel>
        </Border>
      </Grid>

      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
        <StackPanel Spacing="4">
          <TextBlock Text="Shipments" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
          <TextBlock Text="{Binding DataNotice}" TextWrapping="Wrap" Foreground="#64748B" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="STATUS" Classes="kicker" VerticalAlignment="Center" />
          <ComboBox IsEnabled="{Binding IsNotBusy}" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" MinWidth="150" />
        </StackPanel>
        <Button Grid.Column="2" Classes="secondary" Click="OnExportClick" IsEnabled="{Binding CanExport}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="⇩" FontSize="15" />
            <TextBlock Text="Export CSV" />
          </StackPanel>
        </Button>
      </Grid>

      <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <StackPanel>
          <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid ColumnDefinitions="1.15*,1.35*,1.35*,1.05*,1.5*">
              <TextBlock Grid.Column="0" Classes="kicker" Text="TRACKING NUMBER" />
              <TextBlock Grid.Column="1" Classes="kicker" Text="ORIGIN" />
              <TextBlock Grid.Column="2" Classes="kicker" Text="DESTINATION" />
              <TextBlock Grid.Column="3" Classes="kicker" Text="STATUS" />
              <TextBlock Grid.Column="4" Classes="kicker" Text="LAST UPDATED (UTC)" />
            </Grid>
          </Border>
          <ItemsControl ItemsSource="{Binding VisibleShipments}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Padding="16,14">
                  <Grid ColumnDefinitions="1.15*,1.35*,1.35*,1.05*,1.5*" VerticalAlignment="Center">
                    <TextBlock Grid.Column="0" Text="{Binding TrackingNumber}" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Origin}" Foreground="#334155" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="2" Text="{Binding Destination}" Foreground="#334155" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Border Grid.Column="3" Background="#F1F5F9" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" />
                    </Border>
                    <TextBlock Grid.Column="4" Text="{Binding LastUpdatedDisplay}" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border IsVisible="{Binding HasNoVisibleShipments}" Padding="26">
            <StackPanel HorizontalAlignment="Center" Spacing="6">
              <TextBlock Text="No shipments to display" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center" />
              <TextBlock Text="Refresh the data or select another status filter." Foreground="#64748B" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="10" Padding="14,12">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <TextBlock Text="●" Foreground="#2563EB" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
          <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{Binding MessageForeground}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <TextBlock Text="Shipment information is read-only. Status totals include all retrieved branch shipments." Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" />
    </StackPanel>
  </ScrollViewer>
</Window>
